{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bohrium/agent-task.schema.json",
  "title": "Bohrium App Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "attempt",
    "role",
    "stage",
    "objective",
    "repository_root",
    "workflow_revision",
    "required_skills",
    "source_identity",
    "inputs",
    "allowed_write_paths",
    "forbidden_write_paths",
    "authorized_external_actions",
    "exit_gates",
    "evidence_directory",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "bohrium-agent-task/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "discovery",
        "adapter",
        "reviewer",
        "image_builder",
        "release_operator",
        "console_handoff",
        "app_acceptance",
        "skillizer"
      ]
    },
    "stage": {
      "type": "string",
      "pattern": "^S(?:[0-9]|1[0-2])(?:[._-][A-Za-z0-9._-]+)?$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "workflow_revision": {
      "type": "integer",
      "minimum": 0
    },
    "required_skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "allowed_write_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_write_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorized_external_actions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/externalAction"
      }
    },
    "exit_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exitGate"
      }
    },
    "evidence_directory": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256", "dirty"],
      "properties": {
        "revision": {
          "type": ["string", "null"]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": ["boolean", "null"]
        }
      }
    },
    "externalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "action",
        "exact_target",
        "expected_effect",
        "expected_cost_or_duration",
        "rollback_or_recovery",
        "required_preconditions",
        "expected_readback",
        "destructive"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "exact_target": {
          "type": "string",
          "minLength": 1
        },
        "expected_effect": {
          "type": "string",
          "minLength": 1
        },
        "expected_cost_or_duration": {
          "type": "string",
          "minLength": 1
        },
        "rollback_or_recovery": {
          "type": "string",
          "minLength": 1
        },
        "required_preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_readback": {
          "type": "string",
          "minLength": 1
        },
        "destructive": {
          "type": "boolean"
        }
      }
    },
    "exitGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "criterion", "evidence_required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "required": {
          "type": "boolean"
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
